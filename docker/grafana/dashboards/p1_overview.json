{
  "title": "P1 — AI Passenger Assistant Overview",
  "uid": "p1-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "İntent bazlı istek sayısı (toplam)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (intent) (p1_requests_total)",
          "legendFormat": "{{intent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Guardrail tarafından bloklanan istekler (sebep bazlı)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (reason) (p1_guardrail_blocks_total)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Node başına ortalama gecikme (saniye)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(p1_node_latency_seconds_sum[5m]) / rate(p1_node_latency_seconds_count[5m])",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bekleyen onay talebi sayısı",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "p1_approval_queue_pending",
          "refId": "A"
        }
      ]
    }
  ]
}
