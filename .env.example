# Hepsi yerel/ücretsiz servisleri gösterir; gerçek OpenAI hesabı gerekmez.

# --- LLM: Ollama'nın OpenAI-uyumlu endpoint'i ---
OPENAI_API_KEY=ollama-local-no-key-needed
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1

# --- Qdrant (yerel Docker) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=thy_policies

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Langfuse (self-hosted, ücretsiz) — bkz. docker/docker-compose.yml LANGFUSE_INIT_* ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-p1-local-dev-key
LANGFUSE_SECRET_KEY=sk-lf-p1-local-dev-secret

# --- Prometheus/Grafana ---
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# --- Uygulama ---
APP_ENV=local
LOG_LEVEL=INFO
